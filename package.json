{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "description": "Automação de testes E2E e de API com Playwright, TypeScript e Postman",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e",
    "test:api": "playwright test --project=api",
    "test:postman": "newman run postman/restful-booker.postman_collection.json",
    "report": "playwright show-report",
    "typecheck": "tsc -p ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "newman": "^6.2.3",
    "typescript": "^7.0.2"
  }
}
